#: extension.js:52
msgid "Someday"
msgstr "När som helst"

#: extension.js:60
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n} dag försenad"
msgstr[1] "{n} dagar försenad"

#: extension.js:65
msgid "Yesterday"
msgstr "Igår"

#: extension.js:67
msgid "Today"
msgstr "Idag"

#: extension.js:69
msgid "Tomorrow"
msgstr "Imorgon"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:73
#, no-javascript-format
msgid "%b %-d"
msgstr "%-d %b"

#: extension.js:187
msgid "My Day"
msgstr "Min dag"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:191
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%A %-d %B"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:193
msgid "{done} of {total} done"
msgstr "{done} av {total} klara"

#: extension.js:235
msgid "Add a task"
msgstr "Lägg till en uppgift"

#: extension.js:262
msgid "Completed"
msgstr "Slutförda"

#: extension.js:612
msgid "Open Reinschrift"
msgstr "Öppna Reinschrift"

#: extension.js:625
msgid "Create one in the Reinschrift app."
msgstr "Skapa en i Reinschrift-appen."

#. Translators: {path} is where the to-do file was looked for.
#: extension.js:627
msgid "Expected at {path}"
msgstr "Förväntades i {path}"

#: extension.js:629
msgid "No to-do file found"
msgstr "Ingen uppgiftsfil hittades"

#: extension.js:630
msgid "Choose To-do File…"
msgstr "Välj uppgiftsfil…"

#: extension.js:660
msgid "Nothing planned for today"
msgstr "Inget planerat för idag"

#: extension.js:661
msgid "Add a task above or plan some in Reinschrift."
msgstr "Lägg till en uppgift ovan eller planera några i Reinschrift."

#: extension.js:661
msgid "Add a task above."
msgstr "Lägg till en uppgift ovan."

#: extension.js:668
msgid "All done for today"
msgstr "Allt klart för idag"

#: extension.js:726 extension.js:775
msgid "Could not read the to-do file"
msgstr "Kunde inte läsa uppgiftsfilen"

#: extension.js:744 extension.js:793
msgid "Could not save"
msgstr "Kunde inte spara"

#: prefs.js:19
msgid "To-do File"
msgstr "Uppgiftsfil"

#: prefs.js:20
msgid ""
"Without a choice, the extension uses the file set in the Reinschrift app."
msgstr "Utan val använder tillägget filen som är inställd i Reinschrift-appen."

#: prefs.js:25
msgid "Markdown File"
msgstr "Markdown-fil"

#: prefs.js:32
msgid "Use the Reinschrift App’s File"
msgstr "Använd Reinschrift-appens fil"

#: prefs.js:40
msgid "Choose…"
msgstr "Välj…"

#: prefs.js:56
msgid "Automatic"
msgstr "Automatiskt"

#. Translators: {path} is the file the Reinschrift app points to.
#: prefs.js:62
msgid "Automatic: {path}"
msgstr "Automatiskt: {path}"

#: prefs.js:75
msgid "Markdown Files"
msgstr "Markdown-filer"

#: prefs.js:78
msgid "All Files"
msgstr "Alla filer"

#: prefs.js:85
msgid "Choose To-do File"
msgstr "Välj uppgiftsfil"

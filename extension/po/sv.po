#: extension.js:53
msgid "Someday"
msgstr "När som helst"

#: extension.js:61
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n} dag försenad"
msgstr[1] "{n} dagar försenad"

#: extension.js:66
msgid "Yesterday"
msgstr "Igår"

#: extension.js:68
msgid "Today"
msgstr "Idag"

#: extension.js:70
msgid "Tomorrow"
msgstr "Imorgon"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:74
#, no-javascript-format
msgid "%b %-d"
msgstr "%-d %b"

#: extension.js:210
msgid "My Day"
msgstr "Min dag"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:214
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%A %-d %B"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:216
msgid "{done} of {total} done"
msgstr "{done} av {total} klara"

#: extension.js:258
msgid "Add a task"
msgstr "Lägg till en uppgift"

#: extension.js:285
msgid "Completed"
msgstr "Slutförda"

#: extension.js:349
msgid "Open Reinschrift"
msgstr "Öppna Reinschrift"

#: extension.js:690
msgid "Create one in the Reinschrift app."
msgstr "Skapa en i Reinschrift-appen."

#. Translators: {path} is where the to-do file was looked for.
#: extension.js:692
msgid "Expected at {path}"
msgstr "Förväntades i {path}"

#: extension.js:694
msgid "No to-do file found"
msgstr "Ingen uppgiftsfil hittades"

#: extension.js:721
msgid "Nothing planned for today"
msgstr "Inget planerat för idag"

#: extension.js:722
msgid "Add a task above or plan some in Reinschrift."
msgstr "Lägg till en uppgift ovan eller planera några i Reinschrift."

#: extension.js:722
msgid "Add a task above."
msgstr "Lägg till en uppgift ovan."

#: extension.js:729
msgid "All done for today"
msgstr "Allt klart för idag"

#: extension.js:787 extension.js:836
msgid "Could not read the to-do file"
msgstr "Kunde inte läsa uppgiftsfilen"

#: extension.js:805 extension.js:854
msgid "Could not save"
msgstr "Kunde inte spara"


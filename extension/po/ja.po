#: extension.js:51
msgid "Someday"
msgstr "いつか"

#: extension.js:59
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n}日超過"

#: extension.js:64
msgid "Yesterday"
msgstr "昨日"

#: extension.js:66
msgid "Today"
msgstr "今日"

#: extension.js:68
msgid "Tomorrow"
msgstr "明日"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:72
#, no-javascript-format
msgid "%b %-d"
msgstr "%-m月%-d日"

#: extension.js:208
msgid "My Day"
msgstr "今日の予定"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:212
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%-m月%-d日 %A"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:214
msgid "{done} of {total} done"
msgstr "{total}件中{done}件完了"

#: extension.js:224 extension.js:323
msgid "Open Reinschrift"
msgstr "Reinschriftを開く"

#: extension.js:264
msgid "Completed"
msgstr "完了"

#: extension.js:638
msgid "No to-do file found"
msgstr "タスクファイルが見つかりません"

#: extension.js:638
msgid "Create one in the Reinschrift app."
msgstr "Reinschriftアプリで作成してください。"

#: extension.js:658
msgid "Nothing planned for today"
msgstr "今日の予定はまだありません"

#: extension.js:658
msgid "Add tasks to My Day in Reinschrift."
msgstr "Reinschriftで「今日の予定」にタスクを追加しましょう。"

#: extension.js:665
msgid "All done for today"
msgstr "今日のタスクはすべて完了"

#: extension.js:723
msgid "Could not read the to-do file"
msgstr "タスクファイルを読み込めませんでした"

#: extension.js:741
msgid "Could not save"
msgstr "保存できませんでした"

#: extension.js:783
msgid "Could not open the app"
msgstr "アプリを開けませんでした"

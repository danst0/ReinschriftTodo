#: extension.js:53
msgid "Someday"
msgstr "いつか"

#: extension.js:61
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n}日超過"

#: extension.js:66
msgid "Yesterday"
msgstr "昨日"

#: extension.js:68
msgid "Today"
msgstr "今日"

#: extension.js:70
msgid "Tomorrow"
msgstr "明日"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:74
#, no-javascript-format
msgid "%b %-d"
msgstr "%-m月%-d日"

#: extension.js:210
msgid "My Day"
msgstr "今日の予定"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:214
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%-m月%-d日 %A"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:216
msgid "{done} of {total} done"
msgstr "{total}件中{done}件完了"

#: extension.js:258
msgid "Add a task"
msgstr "タスクを追加"

#: extension.js:285
msgid "Completed"
msgstr "完了"

#: extension.js:349
msgid "Open Reinschrift"
msgstr "Reinschriftを開く"

#: extension.js:690
msgid "Create one in the Reinschrift app."
msgstr "Reinschriftアプリで作成してください。"

#. Translators: {path} is where the to-do file was looked for.
#: extension.js:692
msgid "Expected at {path}"
msgstr "{path} にあるはずです"

#: extension.js:694
msgid "No to-do file found"
msgstr "タスクファイルが見つかりません"

#: extension.js:721
msgid "Nothing planned for today"
msgstr "今日の予定はまだありません"

#: extension.js:722
msgid "Add a task above or plan some in Reinschrift."
msgstr "上でタスクを追加するか、Reinschrift で計画してください。"

#: extension.js:722
msgid "Add a task above."
msgstr "上でタスクを追加してください。"

#: extension.js:729
msgid "All done for today"
msgstr "今日のタスクはすべて完了"

#: extension.js:787 extension.js:836
msgid "Could not read the to-do file"
msgstr "タスクファイルを読み込めませんでした"

#: extension.js:805 extension.js:854
msgid "Could not save"
msgstr "保存できませんでした"


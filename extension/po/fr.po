#: extension.js:57 extension.js:224
msgid "Someday"
msgstr "Un jour"

#: extension.js:65
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "En retard de {n} jour"
msgstr[1] "En retard de {n} jours"

#: extension.js:70
msgid "Yesterday"
msgstr "Hier"

#: extension.js:72
msgid "Today"
msgstr "Aujourd'hui"

#: extension.js:74 extension.js:221
msgid "Tomorrow"
msgstr "Demain"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:78
#, no-javascript-format
msgid "%b %-d"
msgstr "%-d %b"

#: extension.js:222
msgid "Weekend"
msgstr "Week-end"

#: extension.js:223
msgid "Next Week"
msgstr "Semaine prochaine"

#: extension.js:231
msgid "Remove from My Day"
msgstr "Retirer de Ma journée"

#: extension.js:256
msgid "My Day"
msgstr "Ma journée"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:260
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%A %-d %B"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:262
msgid "{done} of {total} done"
msgstr "{done} sur {total} terminées"

#: extension.js:304
msgid "Add a task"
msgstr "Ajouter une tâche"

#: extension.js:331
msgid "Completed"
msgstr "Terminées"

#: extension.js:706
msgid "Open Reinschrift"
msgstr "Ouvrir Reinschrift"

#: extension.js:719
msgid "Create one in the Reinschrift app."
msgstr "Créez-en un dans l'application Reinschrift."

#. Translators: {path} is where the to-do file was looked for.
#: extension.js:721
msgid "Expected at {path}"
msgstr "Attendu à l’emplacement {path}"

#: extension.js:723
msgid "No to-do file found"
msgstr "Aucun fichier de tâches trouvé"

#: extension.js:724
msgid "Choose To-do File…"
msgstr "Choisir le fichier de tâches…"

#: extension.js:754
msgid "Nothing planned for today"
msgstr "Rien de prévu pour aujourd'hui"

#: extension.js:755
msgid "Add a task above or plan some in Reinschrift."
msgstr "Ajoutez une tâche ci-dessus ou planifiez-en dans Reinschrift."

#: extension.js:755
msgid "Add a task above."
msgstr "Ajoutez une tâche ci-dessus."

#: extension.js:777
msgid "All done for today"
msgstr "Tout est fait pour aujourd'hui"

#: extension.js:833
msgid "Could not read the to-do file"
msgstr "Impossible de lire le fichier de tâches"

#: extension.js:852
msgid "Could not save"
msgstr "Impossible d'enregistrer"

#: prefs.js:19
msgid "To-do File"
msgstr "Fichier de tâches"

#: prefs.js:20
msgid ""
"Without a choice, the extension uses the file set in the Reinschrift app."
msgstr ""
"Sans choix, l’extension utilise le fichier défini dans l’application "
"Reinschrift."

#: prefs.js:25
msgid "Markdown File"
msgstr "Fichier Markdown"

#: prefs.js:32
msgid "Use the Reinschrift App’s File"
msgstr "Utiliser le fichier de l’application Reinschrift"

#: prefs.js:40
msgid "Choose…"
msgstr "Choisir…"

#: prefs.js:56
msgid "Automatic"
msgstr "Automatique"

#. Translators: {path} is the file the Reinschrift app points to.
#: prefs.js:62
msgid "Automatic: {path}"
msgstr "Automatique : {path}"

#: prefs.js:75
msgid "Markdown Files"
msgstr "Fichiers Markdown"

#: prefs.js:78
msgid "All Files"
msgstr "Tous les fichiers"

#: prefs.js:85
msgid "Choose To-do File"
msgstr "Choisir le fichier de tâches"

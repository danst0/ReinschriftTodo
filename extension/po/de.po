#: extension.js:51
msgid "Someday"
msgstr "Irgendwann"

#: extension.js:59
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n} Tag überfällig"
msgstr[1] "{n} Tage überfällig"

#: extension.js:64
msgid "Yesterday"
msgstr "Gestern"

#: extension.js:66
msgid "Today"
msgstr "Heute"

#: extension.js:68
msgid "Tomorrow"
msgstr "Morgen"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:72
#, no-javascript-format
msgid "%b %-d"
msgstr "%-d. %b"

#: extension.js:208
msgid "My Day"
msgstr "Mein Tag"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:212
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%A, %-d. %B"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:214
msgid "{done} of {total} done"
msgstr "{done} von {total} erledigt"

#: extension.js:224 extension.js:323
msgid "Open Reinschrift"
msgstr "Reinschrift öffnen"

#: extension.js:264
msgid "Completed"
msgstr "Erledigt"

#: extension.js:638
msgid "No to-do file found"
msgstr "Keine Aufgabendatei gefunden"

#: extension.js:638
msgid "Create one in the Reinschrift app."
msgstr "Lege eine in der Reinschrift-App an."

#: extension.js:658
msgid "Nothing planned for today"
msgstr "Für heute ist nichts geplant"

#: extension.js:658
msgid "Add tasks to My Day in Reinschrift."
msgstr "Füge in Reinschrift Aufgaben zu „Mein Tag“ hinzu."

#: extension.js:665
msgid "All done for today"
msgstr "Alles erledigt für heute"

#: extension.js:723
msgid "Could not read the to-do file"
msgstr "Aufgabendatei konnte nicht gelesen werden"

#: extension.js:741
msgid "Could not save"
msgstr "Speichern fehlgeschlagen"

#: extension.js:783
msgid "Could not open the app"
msgstr "App konnte nicht geöffnet werden"

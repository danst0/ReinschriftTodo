#: extension.js:57 extension.js:224
msgid "Someday"
msgstr "Algún momento"

#: extension.js:65
msgid "{n} day overdue"
msgid_plural "{n} days overdue"
msgstr[0] "{n} día de retraso"
msgstr[1] "{n} días de retraso"

#: extension.js:70
msgid "Yesterday"
msgstr "Ayer"

#: extension.js:72
msgid "Today"
msgstr "Hoy"

#: extension.js:74 extension.js:221
msgid "Tomorrow"
msgstr "Mañana"

#. Translators: short due date within the next weeks, a GLib.DateTime
#. format (like strftime); e.g. "%-d. %b" for German.
#: extension.js:78
#, no-javascript-format
msgid "%b %-d"
msgstr "%-d %b"

#: extension.js:222
msgid "Weekend"
msgstr "Fin de semana"

#: extension.js:223
msgid "Next Week"
msgstr "Próxima semana"

#: extension.js:231
msgid "Remove from My Day"
msgstr "Quitar de Mi día"

#: extension.js:256
msgid "My Day"
msgstr "Mi día"

#. Translators: today's date in the menu header, a GLib.DateTime
#. format (like strftime); e.g. "%A, %-d. %B" for German.
#: extension.js:260
#, no-javascript-format
msgid "%A, %B %-d"
msgstr "%A, %-d de %B"

#. Translators: progress in the menu header, e.g. "4 of 13 done".
#: extension.js:262
msgid "{done} of {total} done"
msgstr "{done} de {total} completadas"

#: extension.js:304
msgid "Add a task"
msgstr "Añadir una tarea"

#: extension.js:331
msgid "Completed"
msgstr "Completadas"

#: extension.js:706
msgid "Open Reinschrift"
msgstr "Abrir Reinschrift"

#: extension.js:719
msgid "Create one in the Reinschrift app."
msgstr "Crea uno en la aplicación Reinschrift."

#. Translators: {path} is where the to-do file was looked for.
#: extension.js:721
msgid "Expected at {path}"
msgstr "Se esperaba en {path}"

#: extension.js:723
msgid "No to-do file found"
msgstr "No se encontró ningún archivo de tareas"

#: extension.js:724
msgid "Choose To-do File…"
msgstr "Elegir archivo de tareas…"

#: extension.js:754
msgid "Nothing planned for today"
msgstr "No hay nada planeado para hoy"

#: extension.js:755
msgid "Add a task above or plan some in Reinschrift."
msgstr "Añade una tarea arriba o planifica algunas en Reinschrift."

#: extension.js:755
msgid "Add a task above."
msgstr "Añade una tarea arriba."

#: extension.js:777
msgid "All done for today"
msgstr "Todo hecho por hoy"

#: extension.js:833
msgid "Could not read the to-do file"
msgstr "No se pudo leer el archivo de tareas"

#: extension.js:852
msgid "Could not save"
msgstr "No se pudo guardar"

#: prefs.js:19
msgid "To-do File"
msgstr "Archivo de tareas"

#: prefs.js:20
msgid ""
"Without a choice, the extension uses the file set in the Reinschrift app."
msgstr ""
"Si no eliges ninguno, la extensión usa el archivo configurado en la "
"aplicación Reinschrift."

#: prefs.js:25
msgid "Markdown File"
msgstr "Archivo Markdown"

#: prefs.js:32
msgid "Use the Reinschrift App’s File"
msgstr "Usar el archivo de la aplicación Reinschrift"

#: prefs.js:40
msgid "Choose…"
msgstr "Elegir…"

#: prefs.js:56
msgid "Automatic"
msgstr "Automático"

#. Translators: {path} is the file the Reinschrift app points to.
#: prefs.js:62
msgid "Automatic: {path}"
msgstr "Automático: {path}"

#: prefs.js:75
msgid "Markdown Files"
msgstr "Archivos Markdown"

#: prefs.js:78
msgid "All Files"
msgstr "Todos los archivos"

#: prefs.js:85
msgid "Choose To-do File"
msgstr "Elegir archivo de tareas"
